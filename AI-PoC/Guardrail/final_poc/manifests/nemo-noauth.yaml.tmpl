apiVersion: v1
kind: ConfigMap
metadata:
  name: nemo-noauth-config
  namespace: ${TENANT_NAMESPACE}
data:
  config.yaml: |
    models:
    - type: main
      engine: openai
      parameters:
        base_url: "${MODEL_BASE_URL}"
        model_name: "${MODEL_NAME}"
    rails:
      input:
        flows:
        - check forbidden words
  rails.co: |
    define flow check forbidden words
      $result = execute check_forbidden_words
      if $result != "allowed"
        bot refuse forbidden content
        stop

    define bot refuse forbidden content
      "I cannot help with that request."
  actions.py: |
    from typing import Optional
    from nemoguardrails.actions import action

    @action(is_system_action=True)
    async def check_forbidden_words(context: Optional[dict] = None) -> str:
        message = (context or {}).get("user_message", "").lower()
        return "blocked" if "forbidden" in message else "allowed"
---
apiVersion: trustyai.opendatahub.io/v1alpha1
kind: NemoGuardrails
metadata:
  name: nemo-noauth
  namespace: ${TENANT_NAMESPACE}
  annotations:
    security.opendatahub.io/enable-auth: "false"
spec:
  allowedConsumers:
    namespaces:
      from: All
  exposeRoute: false
  nemoConfigs:
  - name: ${NEMO_CONFIG_ID}
    default: true
    configMaps:
    - nemo-noauth-config
  env:
  - name: OPENAI_API_KEY
    valueFrom:
      secretKeyRef:
        name: api-token-noauth-secret
        key: token
